;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Lurphy's Maw"
run/main_scene="uid://c482h17qwnv50"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

FxManager="*uid://ba24r8bkg84xr"
LimboConsole="*uid://dyxornv8vwibg"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/limbo_console/plugin.cfg", "res://addons/script-ide/plugin.cfg")

